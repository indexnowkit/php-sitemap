{
    "name": "indexnowkit/sitemap",
    "description": "Sitemap reader for indexnowkit: streams sitemap indexes, gzip and text sitemaps into IndexNow submissions; the sitemap command of every adapter",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "sitemap",
        "seo",
        "yandex",
        "bing",
        "indexing"
    ],
    "homepage": "https://indexnowkit.github.io/php/sitemap/",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-sitemap",
        "docs": "https://github.com/indexnowkit/php-sitemap/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-sitemap/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "ext-xmlreader": "*",
        "indexnowkit/console": "^0.1",
        "indexnowkit/core": "^0.7",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "indexnowkit/testing": "^0.1",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-zlib": "Reading gzip-compressed sitemaps"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Sitemap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
